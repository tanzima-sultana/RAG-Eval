#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

changed_files="$(git diff --cached --name-only --diff-filter=ACM)"

run_tests_if_changed() {
    local source_file="$1"
    local test_file="$2"

    if echo "$changed_files" | grep -qxF "$source_file"; then
        echo "${source_file} changed - running ${test_file}"
        if ! python3 -m pytest "$test_file"; then
            echo "${test_file} failed - commit aborted"
            exit 1
        fi
    fi
}

run_tests_if_changed "src/dataset.py" "tests/test_dataset.py"
run_tests_if_changed "src/local/chunking.py" "tests/test_chunking.py"
